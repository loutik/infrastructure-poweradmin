######################################################################################################################
# les chevrons sont là pour indiquer des variables à changer, vous ne devez pas mettre vos secrets dans ces chevrons !
######################################################################################################################

############################
# DATABASE
###########################
DB_TYPE=pgsql
DB_HOST=10.0.17.1
DB_USER=usr_poweradmin
DB_NAME=db_poweradmin
DB_PASS='<coller-votre-mot-de-passe-db>'

############################
# DNS
###########################
DNS_NS1=ns1.infra.loutik.fr
DNS_NS2=ns2.infra.loutik.fr
DNS_HOSTMASTER=hostmaster.loutik.fr
PA_DNS_BACKEND=api
PA_PDNS_API_URL=http://10.0.13.3:8081
# Décommentez pour créer un compte admin au démarrage du conteneur.
# PA_CREATE_ADMIN=true

############################
# AUTHENTIFICATION
############################
PA_SESSION_KEY='<generer-une-cle-aleatoire>'
PA_PDNS_API_KEY='<coller-clé-api-powerdns'
PA_ADMIN_PASSWORD=Azertyuiop123456* # Mot de passe par défaut du compte "admin". PENSEZ À LE CHANGER !

############################
# OIDC
###########################
# Configuration générale
PA_OIDC_ENABLED=true
PA_OIDC_GENERIC_ENABLED=true
PA_OIDC_AUTO_PROVISION=true
PA_OIDC_LINK_BY_EMAIL=true
PA_APPLICATION_URL=https://padm.infra.loutik.fr
PA_OIDC_GENERIC_DISPLAY_NAME="LoutikSSO"
PA_OIDC_GENERIC_NAME="LoutikSSO"
PA_OIDC_GENERIC_AUTO_DISCOVERY=true
PA_OIDC_GENERIC_SCOPES="openid profile email group"

# Configuration Authentik
PA_OIDC_GENERIC_CLIENT_ID=<coller-votre-oidc-client-id>
PA_OIDC_GENERIC_CLIENT_SECRET=<coller-votre-oidc-client-secret>
PA_OIDC_GENERIC_METADATA_URL=https://sso.loutik.fr/application/o/poweradmin-prd/.well-known/openid-configuration
PA_OIDC_GROUP_MAPPING='inf-poweradmin-prd-adm:Administrators'